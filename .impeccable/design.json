      "css": ".ds-dark{background:var(--hero-bg,#18143d);padding:16px;}.ds-card-grants{font-family:var(--font-body,\"Golos Text\",ui-sans-serif,system-ui,sans-serif);position:relative;isolation:isolate;display:flex;flex-direction:column;justify-content:space-between;align-items:flex-start;width:100%;min-width:0;min-height:145px;padding:14px;border:0;border-radius:12px 12px 32px 12px;background:var(--color-lilac,#dfd3ff);color:var(--color-midnight,#18143d);text-align:left;transform:rotate(-3deg);transition:transform 320ms var(--ease-spring,cubic-bezier(.22,1.35,.5,1));box-shadow:0 12px 22px -16px #09071fc9;cursor:pointer;}.ds-card-grants::after{content:\"\";position:absolute;inset:-4px;border:2px solid var(--color-lime,#d6fa64);border-radius:inherit;opacity:0;pointer-events:none;transition:opacity 160ms;}.ds-card-grants .ds-art{position:absolute;top:11px;right:13px;width:44px;height:37px;transition:transform 320ms var(--ease-spring,cubic-bezier(.22,1.35,.5,1));}.ds-card-grants .ds-art svg{width:100%;height:100%;}.ds-card-grants .ds-direction{position:absolute;bottom:13px;right:10px;display:grid;place-items:center;width:23px;height:23px;}.ds-card-grants .ds-direction svg{width:19px;height:19px;transform:rotate(-45deg);transition:transform 220ms var(--ease-out,cubic-bezier(.16,1,.3,1));}.ds-card-grants .ds-check{display:none;transform:none!important;}.ds-card-grants .ds-label{display:block;max-width:100%;padding-right:17px;margin-top:48px;font-size:14px;line-height:1.25;font-weight:600;letter-spacing:-.02em;}.ds-card-grants[aria-pressed=\"true\"]{transform:rotate(0) scale(1.025);}.ds-card-grants[aria-pressed=\"true\"]::after{opacity:1;}.ds-card-grants[aria-pressed=\"true\"] .ds-direction>svg:first-child{display:none;}.ds-card-grants[aria-pressed=\"true\"] .ds-check{display:block;}.ds-card-grants:focus-visible{outline:3px solid var(--color-lime,#d6fa64);outline-offset:6px;}@media(hover:hover) and (pointer:fine){.ds-card-grants:hover{transform:translateY(-6px) rotate(0) scale(1.025);}.ds-card-grants:hover::after{opacity:1;}.ds-card-grants:hover .ds-art{transform:rotate(-12deg) scale(1.1);}.ds-card-grants:hover .ds-direction svg{transform:rotate(0);}}.ds-card-grants:active{transform:scale(.95) rotate(0);transition-duration:90ms;}@media(prefers-reduced-motion:reduce){.ds-card-grants,.ds-card-grants .ds-art,.ds-card-grants svg{transform:none!important;transition:none!important;}.ds-card-grants::after{transition:none!important;}}"
    },
    {
      "name": "Exams concern",
      "kind": "card",
      "refersTo": "concern-exams",
      "description": "Mobile concern button; selection adds a check and lime outline, updates the ring and stays in the hero. CTA enters the existing quiz with the choice.",
      "html": "<div class=\"ds-dark\"><button class=\"ds-card-exams\" type=\"button\" aria-pressed=\"false\"><span class=\"ds-art\"><svg viewBox=\"0 0 120 100\" fill=\"none\" aria-hidden=\"true\"><rect x=\"23\" y=\"39\" width=\"25\" height=\"45\" rx=\"6\" fill=\"currentColor\" opacity=\".45\"/><rect x=\"50\" y=\"25\" width=\"25\" height=\"59\" rx=\"6\" fill=\"currentColor\" opacity=\".7\"/><rect x=\"77\" y=\"11\" width=\"25\" height=\"73\" rx=\"6\" fill=\"currentColor\"/><path d=\"M84 35L90 41L99 28\" stroke=\"#ffdfd3\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span><span class=\"ds-direction\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg><svg class=\"ds-check\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m5 12 4 4 10-10\"/></svg></span><span class=\"ds-label\">Не знаю, как подготовиться к экзаменам</span></button></div>",
