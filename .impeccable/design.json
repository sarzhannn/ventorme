rd-exams:hover .ds-art{transform:rotate(-12deg) scale(1.1);}.ds-card-exams:hover .ds-direction svg{transform:rotate(0);}}.ds-card-exams:active{transform:scale(.95) rotate(0);transition-duration:90ms;}@media(prefers-reduced-motion:reduce){.ds-card-exams,.ds-card-exams .ds-art,.ds-card-exams svg{transform:none!important;transition:none!important;}.ds-card-exams::after{transition:none!important;}}"
    },
    {
      "name": "Language navigation — home",
      "kind": "nav",
      "refersTo": "language-selected",
      "description": "Home-view RU/KZ/EN controls; selected language is reversed on cream.",
      "html": "<div class=\"ds-dark\"><div class=\"ds-languages\" role=\"group\" aria-label=\"Выберите язык\"><button type=\"button\" aria-pressed=\"true\">RU</button><button type=\"button\" aria-pressed=\"false\">KZ</button><button type=\"button\" aria-pressed=\"false\">EN</button></div></div>",
      "css": ".ds-dark{background:var(--hero-bg,#18143d);padding:16px;}.ds-languages{display:inline-flex;gap:2px;padding:3px;border:1px solid #5b537d;border-radius:12px;}.ds-languages button{font-family:var(--font-body,\"Golos Text\",ui-sans-serif,system-ui,sans-serif);min-width:44px;min-height:44px;padding:6px 8px;border:0;border-radius:8px;background:transparent;color:var(--hero-fg,#f8f6f1);font-size:13px;font-weight:600;cursor:pointer;}.ds-languages button[aria-pressed=\"true\"]{background:var(--hero-fg,#f8f6f1);color:var(--hero-bg,#18143d);}.ds-languages button:focus-visible{outline:3px solid var(--color-lime,#d6fa64);outline-offset:3px;}"
    },
    {
      "name": "Motion control",
      "kind": "button",
      "refersTo": "motion-toggle",
      "description": "Pause/resume visual states; the live reduced-motion state is disabled with a localized motion-off label.",
      "html": "<div class=\"ds-dark\"><button class=\"ds-motion\" type=\"button\" aria-pressed=\"false\"><span class=\"ds-motion-icon\" aria-hidden=\"true\"></span><span>Остановить движение</span></button></div>",
      "css": ".ds-dark{background:var(--hero-bg,#18143d);padding:16px;}.ds-motion{font-family:var(--font-body,\"Golos Text\",ui-sans-serif,system-ui,sans-serif);display:flex;align-items:center;gap:8px;min-height:44px;max-width:100%;padding:5px 0;background:none;border:0;color:var(--hero-muted,#d0cbe5);font-size:11px;line-height:1.3;cursor:pointer;}.ds-motion-icon{display:block;width:10px;height:11px;border-inline:3px solid currentColor;}.ds-motion[aria-pressed=\"true\"] .ds-motion-icon{border:0;border-left:9px solid currentColor;border-top:5px solid transparent;border-bottom:5px solid transparent;}.ds-motion:focus-visible{outline:3px solid var(--color-lime,#d6fa64);outline-offset:6px;}.ds-motion:disabled{cursor:default;}@media(hover:hover) and (pointer:fine){.ds-motion:hover{color:var(--color-lime,#d6fa64);}}"
    },
    {
      "name": "Selected concern",
      "kind": "chip",
      "refersTo": "selected-concern",
      "description": "Noninteractive context above the existing quiz; shown after choosing a concern.",
      "html": "<p class=\"ds-selection\"><svg class=\"ds-check\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m5 12 4 4 10-10\"/></svg><span>Не могу выбрать профессию</span></p>",
      "css": ".ds-selection{font-family:var(--font-body,\"Golos Text\",ui-sans-serif,system-ui,sans-serif);display:flex;align-items:center;gap:9px;width:fit-content;max-width:100%;padding:8px 12px;background:#e8dcff;color:#342264;border-radius:8px;font-size:13px;line-height:1.4;}.ds-selection svg{flex:none;width:18px;height:18px;}"
    }
  ],
  "narrative": {
    "northStar": "Unexplored universe",
    "overview": "The approved world is BOLD EDITORIAL × COLORFUL FUTURE × KINETIC TYPOGRAPHY × PLAYFUL MOTION. Strong display lettering, a midnight ground, bright directional accents and tactile abstract geometry make uncertainty feel open and approachable. Movement supports attention and feedback while every choice remains usable with motion disabled.\n\nThis documents the implemented hero/header system and the selected-concern feedback chip entering the existing quiz. Golos Text is global; selection, scrollbar and caret accents also cross the hero boundary. Supporting sections, quiz fields, route views and registration buttons retain their existing layouts and legacy palette in `site/styles.css`. Their migration is a separate stage. Header geometry is shared; its dark colors apply only on the home view. Exact hero composition and visitor sequence belong in [the surface brief](docs/HERO_DIRECTION.md).",
    "keyCharacteristics": [
      "Oversized local display type with language-specific fitting.",
      "Midnight atmosphere with lime action and distinct concern colors.",
      "Asymmetric corners and authored SVG geometry.",
      "Visible defaults, controllable ambient motion and immediate feedback."
    ],
    "rules": [
      {
        "name": "The Scoped Palette Rule",
        "body": "Apply this palette to the hero and its documented shared components; do not silently replace the legacy supporting-section palette.",
        "section": "colors"
      },
      {
        "name": "The User-Controlled Motion Rule",
        "body": "Ambient loops stop when the user pauses, the document is hidden, the hero is offscreen, or reduced motion is requested.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve local fonts and all three language-specific headline fits.",
      "Do keep the primary action and catalog bypass before the scene on phones.",
      "Do retain distinct concern colors, meaningful text and selected-state checks.",
      "Do keep content visible and motion pausable, with live reduced-motion support.",
      "Do preserve the legacy supporting sections until their redesign is explicitly scoped."
    ],
    "donts": [
      "Don't reintroduce the rejected cream/pastel hero as the new visual world.",
      "Don't make decorative SVG geometry interactive or necessary to understand a choice.",
      "Don't turn the hero's exact composition into a universal page template.",
      "Don't invent product capabilities, research findings or conversion metrics."
    ]
  }
}
