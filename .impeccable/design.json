      "html": "<div class=\"ds-dark\"><button class=\"ds-card-career\" type=\"button\" aria-pressed=\"false\"><span class=\"ds-art\"><svg viewBox=\"0 0 120 100\" fill=\"none\" aria-hidden=\"true\"><path d=\"M61 84V53M61 53L29 23M61 53L93 23\" stroke=\"currentColor\" stroke-width=\"15\" stroke-linecap=\"round\"/><path d=\"M22 43V17H48M74 17H100V43\" stroke=\"currentColor\" stroke-width=\"12\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span><span class=\"ds-direction\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg><svg class=\"ds-check\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m5 12 4 4 10-10\"/></svg></span><span class=\"ds-label\">Не могу выбрать профессию</span></button></div>",
      "css": ".ds-dark{background:var(--hero-bg,#18143d);padding:16px;}.ds-card-career{font-family:var(--font-body,\"Golos Text\",ui-sans-serif,system-ui,sans-serif);position:relative;isolation:isolate;display:flex;flex-direction:column;justify-content:space-between;align-items:flex-start;width:100%;min-width:0;min-height:145px;padding:14px;border:0;border-radius:12px 34px 12px 12px;background:var(--color-cream,#f8f6f1);color:var(--color-midnight,#18143d);text-align:left;transform:rotate(-2deg);transition:transform 320ms var(--ease-spring,cubic-bezier(.22,1.35,.5,1));box-shadow:0 12px 22px -16px #09071fc9;cursor:pointer;}.ds-card-career::after{content:\"\";position:absolute;inset:-4px;border:2px solid var(--color-lime,#d6fa64);border-radius:inherit;opacity:0;pointer-events:none;transition:opacity 160ms;}.ds-card-career .ds-art{position:absolute;top:11px;right:13px;width:44px;height:37px;transition:transform 320ms var(--ease-spring,cubic-bezier(.22,1.35,.5,1));}.ds-card-career .ds-art svg{width:100%;height:100%;}.ds-card-career .ds-direction{position:absolute;bottom:13px;right:10px;display:grid;place-items:center;width:23px;height:23px;}.ds-card-career .ds-direction svg{width:19px;height:19px;transform:rotate(-45deg);transition:transform 220ms var(--ease-out,cubic-bezier(.16,1,.3,1));}.ds-card-career .ds-check{display:none;transform:none!important;}.ds-card-career .ds-label{display:block;max-width:100%;padding-right:17px;margin-top:48px;font-size:14px;line-height:1.25;font-weight:600;letter-spacing:-.02em;}.ds-card-career[aria-pressed=\"true\"]{transform:rotate(0) scale(1.025);}.ds-card-career[aria-pressed=\"true\"]::after{opacity:1;}.ds-card-career[aria-pressed=\"true\"] .ds-direction>svg:first-child{display:none;}.ds-card-career[aria-pressed=\"true\"] .ds-check{display:block;}.ds-card-career:focus-visible{outline:3px solid var(--color-lime,#d6fa64);outline-offset:6px;}@media(hover:hover) and (pointer:fine){.ds-card-career:hover{transform:translateY(-6px) rotate(0) scale(1.025);}.ds-card-career:hover::after{opacity:1;}.ds-card-career:hover .ds-art{transform:rotate(-12deg) scale(1.1);}.ds-card-career:hover .ds-direction svg{transform:rotate(0);}}.ds-card-career:active{transform:scale(.95) rotate(0);transition-duration:90ms;}@media(prefers-reduced-motion:reduce){.ds-card-career,.ds-card-career .ds-art,.ds-card-career svg{transform:none!important;transition:none!important;}.ds-card-career::after{transition:none!important;}}"
