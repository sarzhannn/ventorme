    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Mobile baseline; opens the existing quiz without requiring a concern.",
      "html": "<div class=\"ds-dark\"><button class=\"ds-cta\" type=\"button\"><span>Найти свой первый шаг</span><span class=\"ds-cta-arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></button></div>",
      "css": ".ds-dark{background:var(--hero-bg,#18143d);padding:16px;}.ds-cta{font-family:var(--font-body,\"Golos Text\",ui-sans-serif,system-ui,sans-serif);display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;min-height:58px;padding:10px 12px 10px 18px;border:0;border-radius:12px;background:var(--cta-bg,#d6fa64);color:var(--cta-fg,#18143d);font-size:16px;font-weight:700;line-height:1.3;letter-spacing:-.025em;cursor:pointer;box-shadow:0 7px 18px -8px #b9ed4670;transition:transform 240ms var(--ease-spring,cubic-bezier(.22,1.35,.5,1));}.ds-cta-arrow{display:grid;flex:none;place-items:center;width:35px;height:35px;border-radius:50%;background:var(--cta-fg,#18143d);color:var(--cta-bg,#d6fa64);}.ds-cta-arrow svg{width:21px;height:21px;transition:transform 240ms var(--ease-spring,cubic-bezier(.22,1.35,.5,1));}.ds-cta:focus-visible{outline:3px solid var(--color-lime,#d6fa64);outline-offset:6px;}@media(hover:hover) and (pointer:fine){.ds-cta:hover{transform:translateY(-3px);}.ds-cta:hover svg{transform:translateX(3px);}}.ds-cta:active{transform:translateY(3px) scale(.985);transition-duration:90ms;}@media(prefers-reduced-motion:reduce){.ds-cta,.ds-cta svg{transform:none!important;transition:none!important;}}"
    },
    {
      "name": "Catalog bypass",
      "kind": "button",
      "refersTo": "button-catalog",
      "description": "A visible alternative to the quiz, below the primary action and promise.",
      "html": "<div class=\"ds-dark\"><button class=\"ds-catalog\" type=\"button\">Не хочу проходить вопросы — просто покажите возможности</button></div>",
      "css": ".ds-dark{background:var(--hero-bg,#18143d);padding:16px;}.ds-catalog{font-family:var(--font-body,\"Golos Text\",ui-sans-serif,system-ui,sans-serif);display:block;width:100%;min-height:44px;padding:8px 0;border:0;background:transparent;color:var(--hero-fg,#f8f6f1);font-size:13px;line-height:1.5;text-align:center;text-decoration:underline;text-decoration-color:#a099be;text-underline-offset:4px;white-space:normal;overflow-wrap:break-word;cursor:pointer;}.ds-catalog:focus-visible{outline:3px solid var(--color-lime,#d6fa64);outline-offset:6px;}@media(hover:hover) and (pointer:fine){.ds-catalog:hover{color:var(--color-lime,#d6fa64);}}"
    },
    {
